{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.provenance.dev/config/v1/schema.json",
  "title": "Provenance configuration v1",
  "description": "Authoritative schema for provenance.yml. All durations are integer seconds, memory and disk quantities are integer MiB, and CPU quantities are decimal cores.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "project",
    "artifact",
    "paper",
    "dependencies",
    "tests",
    "release",
    "network",
    "resources"
  ],
  "properties": {
    "apiVersion": {
      "const": "provenance.dev/v1"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "paper": {
      "$ref": "#/$defs/paper"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "resources": {
      "$ref": "#/$defs/resources"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "minecraftVersion": {
      "type": "string",
      "pattern": "^1\\.(?:[1-9]|[1-9][0-9])(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?!localhost$)(?![0-9]+(?:\\.[0-9]+){3}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))+$"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "paperEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minecraftVersion",
        "paperBuild",
        "javaVersion",
        "policy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "minecraftVersion": {
          "$ref": "#/$defs/minecraftVersion"
        },
        "paperBuild": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "javaVersion": {
          "type": "integer",
          "minimum": 8,
          "maximum": 99
        },
        "policy": {
          "enum": ["required", "informational"]
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix", "recommendations", "gatePolicy"],
      "properties": {
        "matrix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/paperEnvironment"
          }
        },
        "recommendations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "apiFloor", "newVersions"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiFloor": {
              "$ref": "#/$defs/minecraftVersion"
            },
            "newVersions": {
              "const": "informational"
            }
          }
        },
        "gatePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requiredFailure",
            "informationalFailure",
            "infrastructureFailure",
            "maxInfrastructureRetries"
          ],
          "properties": {
            "requiredFailure": {
              "const": "block"
            },
            "informationalFailure": {
              "const": "report"
            },
            "infrastructureFailure": {
              "const": "retry"
            },
            "maxInfrastructureRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      }
    },
    "dependency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "provider",
            "projectId",
            "versionId",
            "sha256",
            "required"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "provider": {
              "const": "modrinth"
            },
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "versionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "required": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "provider",
            "artifactId",
            "version",
            "sha256",
            "required"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "provider": {
              "const": "organization-upload"
            },
            "artifactId": {
              "$ref": "#/$defs/identifier"
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "required": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "pattern", "match"],
      "properties": {
        "stream": {
          "enum": ["stdout", "stderr", "combined"]
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "operator": {
          "enum": ["contains", "regex"],
          "default": "regex"
        },
        "match": {
          "enum": ["present", "absent"]
        },
        "minimumOccurrences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "operator": {
                "const": "regex"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "format": "regex"
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "match": {
                "const": "absent"
              }
            },
            "required": ["match"]
          },
          "then": {
            "type": "object",
            "not": {
              "type": "object",
              "properties": {
                "minimumOccurrences": {}
              },
              "required": ["minimumOccurrences"]
            }
          }
        }
      ]
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "console"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeoutSeconds",
            "stabilizationSeconds",
            "requirePluginEnabled",
            "shutdownTimeoutSeconds",
            "requireCleanShutdown"
          ],
          "properties": {
            "timeoutSeconds": {
              "$ref": "#/$defs/durationSeconds"
            },
            "stabilizationSeconds": {
              "$ref": "#/$defs/durationSeconds"
            },
            "requirePluginEnabled": {
              "type": "boolean"
            },
            "shutdownTimeoutSeconds": {
              "$ref": "#/$defs/durationSeconds"
            },
            "requireCleanShutdown": {
              "type": "boolean"
            }
          }
        },
        "console": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "timeoutSeconds", "assertions"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^[^\\r\\n\\u0000]+$"
              },
              "timeoutSeconds": {
                "$ref": "#/$defs/durationSeconds"
              },
              "assertions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/assertion"
                }
              }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "targets"],
      "properties": {
        "mode": {
          "enum": ["test-only", "manual", "automatic"]
        },
        "targets": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "test-only"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "targets": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "targets": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowlist"],
      "properties": {
        "mode": {
          "enum": ["none", "restricted", "allowlist", "unrestricted"]
        },
        "allowlist": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostname", "ports"],
            "properties": {
              "hostname": {
                "$ref": "#/$defs/hostname"
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/port"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "allowlist"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "allowlist": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "allowlist": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuCores",
        "memoryMiB",
        "diskMiB",
        "processes",
        "wallTimeoutSeconds",
        "logBytes"
      ],
      "properties": {
        "cpuCores": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 16,
          "multipleOf": 0.1
        },
        "memoryMiB": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32768
        },
        "diskMiB": {
          "type": "integer",
          "minimum": 256,
          "maximum": 131072
        },
        "processes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "wallTimeoutSeconds": {
          "$ref": "#/$defs/durationSeconds"
        },
        "logBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        }
      }
    }
  }
}
